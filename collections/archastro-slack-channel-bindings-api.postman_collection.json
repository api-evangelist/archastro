        {
          "id": "c01ee5b2-1f7c-407f-bfa2-3c17f4679067",
          "name": "List Slack channel bindings",
          "request": {
            "name": "List Slack channel bindings",
            "description": {
              "content": "Returns a page of Slack channel bindings visible to the authenticated user.\nResults can be filtered by integration, team, agent, or organization. Omit all\nfilter params to retrieve every binding the caller can see.\n\nPagination is page-based. Pass `page` and `per_page` to navigate large result\nsets. `page` must be a positive integer; `per_page` must be between 1 and 100.\nInvalid values return 400.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "slack_channel_bindings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "<integer>",
                  "description": "Number of bindings to return per page. Defaults to 25; maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number to retrieve, 1-indexed. Defaults to 1. Must be a positive integer."
                },
                {
                  "disabled": false,
                  "key": "team",
                  "value": "<string>",
                  "description": "Return only bindings bound to one of these team IDs. Omit to return bindings for all teams."
                },
                {
                  "disabled": false,
                  "key": "team",
                  "value": "<string>",
                  "description": "Return only bindings bound to one of these team IDs. Omit to return bindings for all teams."
                },
                {
                  "disabled": false,
                  "key": "org",
                  "value": "<string>",
                  "description": "Return only bindings that belong to one of these organization IDs. Omit to return bindings across all organizations visible to the caller."
                },
                {
                  "disabled": false,
                  "key": "org",
                  "value": "<string>",
                  "description": "Return only bindings that belong to one of these organization IDs. Omit to return bindings across all organizations visible to the caller."
                },
                {
                  "disabled": false,
                  "key": "agent",
                  "value": "<string>",
                  "description": "Return only bindings that have at least one of these agent user IDs attached. Omit to return bindings regardless of agent attachment."
                },
                {
                  "disabled": false,
                  "key": "agent",
                  "value": "<string>",
                  "description": "Return only bindings that have at least one of these agent user IDs attached. Omit to return bindings regardless of agent attachment."
                },
                {
                  "disabled": false,
                  "key": "integration",
                  "value": "<string>",
                  "description": "Return only bindings whose Slack integration matches one of these integration IDs. Omit to return bindings across all integrations."
                },
                {
                  "disabled": false,
                  "key": "integration",
                  "value": "<string>",
                  "description": "Return only bindings whose Slack integration matches one of these integration IDs. Omit to return bindings across all integrations."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
