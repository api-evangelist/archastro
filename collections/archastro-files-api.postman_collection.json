          "name": "Upload a file",
          "request": {
            "name": "Upload a file",
            "description": {
              "content": "Creates a new file from base64-encoded content and returns the resulting file object,\nincluding a signed download URL. Use this endpoint to store images, documents, or\nother binary assets that can then be referenced by agents, teams, or users.\n\nApp scope is derived from the authenticated viewer's bearer token or publishable key.\nYou may optionally associate the file with an organization, team, user, or agent by\npassing the corresponding ID. If no owner is specified and the viewer is a user, the\nfile is automatically attributed to that user.\n\nReturns `422` when the `data` field is not valid base64 or the changeset is invalid.\nReturns `403` when the request lacks the required app scope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
